{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "door-access-control",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
